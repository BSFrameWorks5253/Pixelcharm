{
  "name": "pixelcharm",
  "version": "1.0.0",
  "description": "Pixelcharm — Creative Canvas & Photo Magic for Anything Apps",
  "main": "dist-electron/main.js",
  "author": "BSFrameworks5253",
  "repository": {
    "type": "git",
    "url": "https://github.com/BSFrameworks5253/Pixelcharm.git"
  },
  "scripts": {
    "dev": "concurrently -k -r \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on -t 30000 tcp:127.0.0.1:5185 && npm run build:electron && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5185 electron dist-electron/main.js",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:icons": "python scripts/generate_app_icons.py",
    "build": "npm run build:vite && npm run build:electron",
    "build:win": "npm run build:icons && npm run build && electron-builder --win nsis --x64",
    "release:github": "node scripts/publish-to-github.mjs",
    "start": "npm run build && electron dist-electron/main.js",
    "start:fast": "electron dist-electron/main.js",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.anything.pixelcharm",
    "productName": "Pixelcharm",
    "copyright": "Copyright © 2026 BSFrameWorks",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "loader-config.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "BSFrameworks5253",
      "repo": "Pixelcharm"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Pixelcharm_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pixelcharm Studio",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "Pixelcharm Studio"
    }
  },
  "dependencies": {
    "ag-psd": "^34.1.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.0.4"
  }
}
